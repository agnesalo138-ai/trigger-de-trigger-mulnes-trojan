local tabs = {}
local function createTabContent(name)
    local scrollingFrame = Instance.new("ScrollingFrame")
    scrollingFrame.Size = UDim2.new(1, 0, 1, 0)
    scrollingFrame.BackgroundTransparency = 1
    scrollingFrame.BorderSizePixel = 0
    scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 500)
    scrollingFrame.ScrollBarThickness = 3
    scrollingFrame.Visible = false
    scrollingFrame.Parent = ContentContainer
    tabs[name] = scrollingFrame
    return scrollingFrame
end

local tabY = 0
local function createSidebarButton(name, targetTab)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 36)
    btn.Position = UDim2.new(0, 0, 0, tabY)
    btn.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
    btn.BorderSizePixel = 0
    btn.Text = "  " .. name
    btn.TextColor3 = Color3.fromRGB(170, 170, 185)
    btn.TextSize, btn.Font = 12, Enum.Font.GothamMedium
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = Sidebar

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do t.Visible = false end
        for _, b in pairs(Sidebar:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(20, 20, 26)
                b.TextColor3 = Color3.fromRGB(170, 170, 185)
            end
        end
        targetTab.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(180, 140, 20)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    tabY = tabY + 42
    Sidebar.CanvasSize = UDim2.new(0, 0, 0, tabY)
end

