-- Helper Functions for Elements
local function addToggle(tab, name, callback)
    local yPos = #tab:GetChildren() * 42
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 36)
    btn.Position = UDim2.new(0, 5, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    btn.BorderSizePixel = 0
    btn.Text = "  " .. name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(170, 170, 185)
    btn.TextSize, btn.Font = 12, Enum.Font.Gotham
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = tab

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local status = false
    btn.MouseButton1Click:Connect(function()
        status = not status
        btn.Text = "  " .. name .. ": " .. (status and "ON" or "OFF")
        btn.BackgroundColor3 = status and Color3.fromRGB(120, 40, 200) or Color3.fromRGB(22, 22, 30)
        btn.TextColor3 = status and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(170, 170, 185)
        callback(status)
    end)
    tab.CanvasSize = UDim2.new(0, 0, 0, yPos + 46)
end

