addSectionHeader(tabESP, "ESP Execution")
local espActive = false
addToggle(tabESP, "Enable Player ESP", function(state)
    espActive = state
    task.spawn(function()
        while espActive do
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character then
                    local char = p.Character
                    local hl = char:FindFirstChild("NexusESPHighlight") or Instance.new("Highlight")
                    hl.Name = "NexusESPHighlight"
                    hl.Parent = char
                    hl.Enabled = espActive

                    if espGameType:find("MM2") then
                        -- MM2 Role Detection Logic: Knife = Red, Gun = Blue, Other/Innocent = Green
                        local hasKnife = false
                        local hasGun = false

                        -- Check character tools
                        for _, item in ipairs(char:GetChildren()) do
                            if item:IsA("Tool") then
                                local lname = item.Name:lower()
                                if lname:find("knife") or lname:find("dagger") then hasKnife = true end
                                if lname:find("gun") or lname:find("revolver") or lname:find("sheriff") then hasGun = true end
                            end
                        end

                        -- Check backpack tools
                        local bp = p:FindFirstChild("Backpack")
                        if bp then
                            for _, item in ipairs(bp:GetChildren()) do
                                if item:IsA("Tool") then
                                    local lname = item.Name:lower()
                                    if lname:find("knife") or lname:find("dagger") then hasKnife = true end
                                    if lname:find("gun") or lname:find("revolver") or lname:find("sheriff") then hasGun = true end
                                end
                            end
                        end

                        if hasKnife then
                            hl.FillColor = Color3.fromRGB(255, 50, 50) -- Red (Murderer)
                        elseif hasGun then
                            hl.FillColor = Color3.fromRGB(50, 100, 255) -- Blue (Sheriff)
                        else
                            hl.FillColor = Color3.fromRGB(50, 255, 50) -- Green (Innocent)
                        end
                    else
                        -- Standard Neutral Chams Color
                        hl.FillColor = Color3.fromRGB(0, 162, 255)
                    end
                end
            end
            task.wait(1)
        end

        -- Cleanup when turned off
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("NexusESPHighlight") then
                p.Character.NexusESPHighlight.Enabled = false
            end
        end
    end)
end)


-- ==================== RESPONSIVE TELEPORT HELPER ====================
local function executeTeleport(targetPart, mode, speedVal, getState)
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    
    if getState and not getState() then return end
    local destCF = targetPart.CFrame + Vector3.new(0, 3, 0)

    if mode == "Fast" then
        hrp.CFrame = destCF
    elseif mode == "Slow" then
        local steps = 15
        for i = 1, steps do
            if getState and not getState() then return end
            hrp.CFrame = hrp.CFrame:Lerp(destCF, i / steps)
            task.wait(0.01)
        end
    elseif mode == "Tween" then
        local dist = (hrp.Position - targetPart.Position).Magnitude
        local duration = math.max(0.1, dist / (speedVal or 60))
        local tween = TweenService:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Linear), {CFrame = destCF})
        tween:Play()
        
        local heartbeatConn
        if getState then
            heartbeatConn = RunService.Heartbeat:Connect(function()
                if not getState() then
                    tween:Cancel()
                    if heartbeatConn then heartbeatConn:Disconnect() end
                end
            end)
        end
        
        tween.Completed:Wait()
        if heartbeatConn then heartbeatConn:Disconnect() end
    end
end


