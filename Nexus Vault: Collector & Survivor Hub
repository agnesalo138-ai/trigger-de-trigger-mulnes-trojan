-- UI Element Helpers
local function addSectionHeader(tab, text)
    local yPos = #tab:GetChildren() * 42
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 28)
    label.Position = UDim2.new(0, 5, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text = "  " .. text
    label.TextColor3 = Color3.fromRGB(0, 162, 255)
    label.TextSize, label.Font = 12, Enum.Font.GothamBold
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = tab
    tab.CanvasSize = UDim2.new(0, 0, 0, yPos + 35)
end

local function addToggle(tab, name, callback)
    local yPos = #tab:GetChildren() * 42
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 36)
    btn.Position = UDim2.new(0, 5, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 34)
    btn.BorderSizePixel = 0
    btn.Text = "  " .. name .. ": OFF"
    btn.TextColor3 = Color3.fromRGB(180, 180, 195)
    btn.TextSize, btn.Font = 12, Enum.Font.Gotham
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = tab

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    local status = false
    btn.MouseButton1Click:Connect(function()
        status = not status
        btn.Text = "  " .. name .. ": " .. (status and "ON" or "OFF")
        btn.BackgroundColor3 = status and Color3.fromRGB(0, 130, 220) or Color3.fromRGB(25, 25, 34)
        btn.TextColor3 = status and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(180, 180, 195)
        callback(status)
    end)
    tab.CanvasSize = UDim2.new(0, 0, 0, yPos + 46)
end

local function addConfigButton(tab, name, options, callback)
    local yPos = #tab:GetChildren() * 42
    local index = 1
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 36)
    btn.Position = UDim2.new(0, 5, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 30, 42)
    btn.BorderSizePixel = 0
    btn.Text = "  [Config] " .. name .. ": " .. options[index]
    btn.TextColor3 = Color3.fromRGB(200, 200, 210)
    btn.TextSize, btn.Font = 12, Enum.Font.Gotham
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = tab

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = btn

    btn.MouseButton1Click:Connect(function()
        index = index + 1
        if index > #options then index = 1 end
        btn.Text = "  [Config] " .. name .. ": " .. options[index]
        callback(options[index])
    end)
    tab.CanvasSize = UDim2.new(0, 0, 0, yPos + 46)
end


