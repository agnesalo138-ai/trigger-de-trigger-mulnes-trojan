-- AI Runtime Logic: Target Selection with Transparent Wall & Team Check
local function getValidEnemyTarget()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return nil end
    local myRoot = character.HumanoidRootPart
    local nearestTarget = nil
    local shortestDistance = math.huge

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") then
            if p.Character.Humanoid.Health > 0 then
                -- Team Check
                local isTeammate = false
                if player.Team and p.Team and player.Team == p.Team then
                    isTeammate = true
                end

                if not isTeammate then
                    local targetRoot = p.Character.HumanoidRootPart
                    local distance = (myRoot.Position - targetRoot.Position).Magnitude

                    -- Raycast check for wall/transparent parts line-of-sight
                    local rayParams = RaycastParams.new()
                    rayParams.FilterDescendantsInstances = {character}
                    rayParams.FilterType = Enum.RaycastFilterType.Exclude
                    rayParams.IgnoreWater = true

                    local origin = myRoot.Position + Vector3.new(0, 2, 0)
                    local direction = (targetRoot.Position - origin)
                    local rayResult = workspace:Raycast(origin, direction, rayParams)

                    local hasLineOfSight = true
                    if rayResult and rayResult.Instance then
                        -- Check if blocking part is transparent or non-collidable (glass windows, transparent barriers)
                        if rayResult.Instance.Transparency > 0 or not rayResult.Instance.CanCollide then
                            hasLineOfSight = true -- Can see and aim through transparent parts!
                        else
                            hasLineOfSight = false -- Blocked by a solid opaque wall
                        end
                    end

                    if hasLineOfSight and distance < shortestDistance then
                        shortestDistance = distance
                        nearestTarget = targetRoot
                    end
                end
            end
        end
    end
    return nearestTarget
end

-- Autonomous AI & Combat Loop
local lastClickTick = 0
local wanderTarget = nil
local wanderTimer = 0

RunService.RenderStepped:Connect(function(dt)
    if not botplaySettings.Enabled then return end

    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end

    -- 1. Target Acquisition & Aimbot
    local target = nil
    if botplaySettings.Aimbot then
        target = getValidEnemyTarget()
        if target then
            -- Smoothly aim camera/character at the enemy
            rootPart.CFrame = CFrame.new(rootPart.Position, Vector3.new(target.Position.X, rootPart.Position.Y, target.Position.Z))
        end
    end

    -- 2. Combat Automation (2 CPS Left-click + Crouch 'C')
    if botplaySettings.AutoAttack and target then
        local currentTick = tick()
        if currentTick - lastClickTick >= 0.5 then -- 2 clicks per second (1/2 = 0.5s interval)
            lastClickTick = currentTick
            pcall(function()
                VirtualUser:Button1Down(Vector2.new(0, 0))
                task.wait(0.04)
                VirtualUser:Button1Up(Vector2.new(0, 0))
            end)
        end

        -- Simulate crouching with 'C' key when engaged with enemy
        pcall(function()
            keypress(0x43) -- 'C' key hex code
            task.wait(0.05)
            keyrelease(0x43)
        end)
    end

    -- 3. AFK Walking & Navigation
    if botplaySettings.AFKWalk then
        if target then
            -- Move directly towards the detected enemy
            humanoid:MoveTo(target.Position)
        else
            -- Wander around automatically when idling AFK
            wanderTimer = wanderTimer - dt
            if wanderTimer <= 0 or not wanderTarget then
                wanderTimer = math.random(4, 8)
                local randomOffset = Vector3.new(math.random(-30, 30), 0, math.random(-30, 30))
                wanderTarget = rootPart.Position + randomOffset
            end
            humanoid:MoveTo(wanderTarget)
        end
    end

    -- 4. Smart Gap Jump & Stair Safety Logic
    if botplaySettings.SmartJump then
        local lookVector = rootPart.CFrame.LookVector
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {character}
        rayParams.FilterType = Enum.RaycastFilterType.Exclude

        -- Check if walking up or down stairs to prevent false jumping
        local isStairsOrRamp = false
        local forwardCheck = workspace:Raycast(rootPart.Position, lookVector * 4, rayParams)
        if forwardCheck and forwardCheck.Instance then
            local partName = string.lower(forwardCheck.Instance.Name)
            if string.find(partName, "stair") or string.find(partName, "step") or string.find(partName, "ramp") or string.find(partName, "slant") then
                isStairsOrRamp = true
            end
        end

        -- Check for a gap ahead (space in the middle where ground drops off)
        local gapCheckPos = rootPart.Position + (lookVector * 4) + Vector3.new(0, 2, 0)
        local gapRay = workspace:Raycast(gapCheckPos, Vector3.new(0, -8, 0), rayParams)

        -- If there is a gap ahead, no ground is found, AND we are not on stairs -> jump across safely!
        if not gapRay and not isStairsOrRamp then
            humanoid.Jump = true
        end
    end
end)

